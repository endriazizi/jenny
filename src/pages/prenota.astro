---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import '../styles/booking.css';
import { SITE, waLink, WA_HELLO } from '../data/site';
import { BOOKING_ONLINE, BOOKING_API, PRIVACY_VERSION } from '../data/booking';

const wa = waLink(WA_HELLO);
---
<Base title="Prenota online · Jenny Nails Studio" description="Scegli trattamento, giorno e orario e prenota da Jenny Nails Studio." noindex>
  <section class="bk">
    <p class="eyebrow">Prenotazione</p>
    <h1 class="title-lg">Prenota il tuo <em>appuntamento</em></h1>

    <div id="fallback" class="card panel" hidden={BOOKING_ONLINE}>
      <h2>Prenota con un messaggio</h2>
      <p class="muted" id="fallback-why">La prenotazione online non è disponibile in questo momento. Scrivici o chiamaci: ti rispondiamo con l’orario libero.</p>
      <div class="actions">
        {wa && <a class="btn btn-wa" href={wa} rel="noopener"><Icon name="message-circle" />Scrivi su WhatsApp</a>}
        {SITE.phone && <a class="btn btn-ghost" href={`tel:${SITE.phone.tel}`}><Icon name="phone" />{SITE.phone.display}</a>}
      </div>
    </div>

    {BOOKING_ONLINE && (
      <div id="app" data-api={BOOKING_API} data-privacy={PRIVACY_VERSION}>
        <p class="muted lead">Scegli i trattamenti, il giorno e l’orario. Confermi con un codice che ti mandiamo via email: niente account, niente password.</p>
        <ol class="steps" aria-label="Passaggi">
          <li data-s="1">1 · Trattamenti</li>
          <li data-s="2">2 · Quando</li>
          <li data-s="3">3 · Dati</li>
          <li data-s="4">4 · Conferma</li>
        </ol>
        <div id="view" aria-live="polite"><p class="muted">Carico i trattamenti…</p></div>
        <noscript><p class="err">Per prenotare online serve JavaScript. Puoi sempre scriverci su WhatsApp o chiamarci.</p></noscript>
      </div>
    )}
  </section>
</Base>

<script>
  import { api, ApiError, h, slotPicker, whenLabel, euro, durationLabel, type Slot, type DaySummary } from '../scripts/booking-client';

  interface Service { id: number; category_id: number | null; name: string; description: string | null; price_cents: number | null; duration_min: number }
  interface Catalog {
    salon: { name: string; phone: string | null };
    rules: { max_advance_days: number; customer_change_limit_h: number; auto_confirm: boolean; privacy_version: string; whatsapp_available: boolean; public_show_price?: boolean; public_show_duration?: boolean };
    categories: { id: number; name: string }[];
    services: Service[];
  }
  interface Customer { first_name: string; last_name: string; email: string; phone: string | null }
  interface PublicBooking { status: string; starts_at: string; items: { name: string; price_cents: number | null; duration_min: number }[]; total_cents: number | null }

  const app = document.getElementById('app');
  if (app) start(app);

  function start(app: HTMLElement) {
    const API = app.dataset.api!;
    const view = document.getElementById('view')!;
    const state = { selected: new Set<number>(), date: '', time: '', token: '', expires: 0, customer: { first_name: '', last_name: '', email: '', phone: null } as Customer };
    let cat: Catalog;

    const setStep = (n: number) =>
      app.querySelectorAll<HTMLElement>('.steps li').forEach((li) => {
        const s = Number(li.dataset.s);
        if (s === n) li.setAttribute('aria-current', 'step');
        else li.removeAttribute('aria-current');
        li.classList.toggle('done', s < n);
      });
    const show = (n: number, ...nodes: Node[]) => {
      setStep(n);
      app.classList.toggle('bk-confirming', n === 4);
      view.replaceChildren(...nodes);
      app.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    const chosen = () => cat.services.filter((s) => state.selected.has(s.id));
    const totals = () => {
      const list = chosen();
      const priced = list.every((s) => s.price_cents !== null);
      return {
        min: list.reduce((a, s) => a + s.duration_min, 0),
        price: priced ? list.reduce((a, s) => a + (s.price_cents || 0), 0) : null,
      };
    };
    const fallback = (why?: string) => {
      app.hidden = true;
      const fb = document.getElementById('fallback')!;
      if (why) document.getElementById('fallback-why')!.textContent = why;
      fb.hidden = false;
    };

    api<Catalog>(API, '/catalog')
      .then((c) => {
        cat = c;
        if (!c.services.length) return fallback('I trattamenti prenotabili online saranno disponibili a breve. Intanto scrivici o chiamaci.');
        const wanted = new URLSearchParams(location.search).get('t')?.toLowerCase();
        if (wanted) c.services.filter((s) => s.name.toLowerCase().startsWith(wanted)).slice(0, 1).forEach((s) => state.selected.add(s.id));
        stepServices();
      })
      .catch(() => fallback());

    // 1 · Trattamenti
    function stepServices() {
      const groups = [...cat.categories, { id: 0, name: 'Altri trattamenti' }].map((g) => ({
        g,
        list: cat.services.filter((s) => (g.id ? s.category_id === g.id : !cat.categories.some((c) => c.id === s.category_id))),
      }));
      const sumText = h('span');
      const next = h('button', { type: 'button', class: 'btn btn-primary' }, 'Avanti');
      const refresh = () => {
        const t = totals();
        next.disabled = !state.selected.size;
        sumText.textContent = state.selected.size ? [cat.rules.public_show_duration ? durationLabel(t.min) : '', cat.rules.public_show_price ? euro(t.price) : ''].filter(Boolean).join(' · ') || `${state.selected.size} trattament${state.selected.size === 1 ? 'o' : 'i'} selezionati` : 'Scegli almeno un trattamento';
      };
      const blocks = groups.filter((x) => x.list.length).map(({ g, list }) =>
        h('div', { class: 'cat' }, h('h3', {}, g.name), ...list.map((s) => {
          const box = h('input', { type: 'checkbox', checked: state.selected.has(s.id) });
          box.addEventListener('change', () => { box.checked ? state.selected.add(s.id) : state.selected.delete(s.id); refresh(); });
          return h('label', { class: 'svc' }, box,
            h('span', { class: 't' }, h('strong', {}, s.name), s.description && h('span', { class: 'm' }, s.description), cat.rules.public_show_duration && h('span', { class: 'm' }, durationLabel(s.duration_min))),
            cat.rules.public_show_price && h('span', { class: 'p' }, euro(s.price_cents)));
        })));
      next.addEventListener('click', stepSlot);
      refresh();
      show(1, h('div', { class: 'card panel' }, h('h2', {}, 'Cosa ti facciamo?'),
        h('p', { class: 'muted small' }, cat.rules.public_show_price ? 'Puoi sceglierne più di uno: li facciamo uno dopo l’altro. I prezzi sono di listino, eventuali extra si concordano in salone.' : 'Puoi sceglierne più di uno: li facciamo uno dopo l’altro.'),
        ...blocks, h('div', { class: 'sum' }, sumText, next)));
    }

    // 2 · Giorno e ora
    function stepSlot() {
      const ids = [...state.selected].join(',');
      const picker = slotPicker({
        days: Math.min(Math.max(cat.rules.max_advance_days, 1), 60),
        load: (date) => api<{ slots: Slot[] }>(API, `/availability?date=${date}&services=${ids}`),
        loadDays: (from, count) => api<{ days: DaySummary[] }>(API, `/availability/days?from=${from}&days=${count}&services=${ids}`),
        onPick: (date, time) => { state.date = date; state.time = time; stepDetails(); },
      });
      const back = h('button', { type: 'button', class: 'linkbtn' }, '← Cambia trattamenti');
      back.addEventListener('click', stepServices);
      show(2, h('div', { class: 'card panel' }, h('h2', {}, 'Quando vieni?'),
        cat.rules.public_show_duration && h('p', { class: 'muted small' }, `Durata prevista: ${durationLabel(totals().min)}.`), picker, back));
    }

    // 3 · Dati e consensi
    function stepDetails() {
      const field = (label: string, input: HTMLElement) => h('label', { class: 'f' }, label, input);
      const first = h('input', { type: 'text', name: 'first_name', required: true, maxlength: 80, autocomplete: 'given-name' });
      const last = h('input', { type: 'text', name: 'last_name', required: true, maxlength: 80, autocomplete: 'family-name' });
      const email = h('input', { type: 'email', name: 'email', required: true, maxlength: 190, autocomplete: 'email', inputmode: 'email' });
      const phone = h('input', { type: 'tel', name: 'phone', maxlength: 20, autocomplete: 'tel', inputmode: 'tel', placeholder: '+39 …' });
      const note = h('textarea', { name: 'note', rows: 3, maxlength: 500 });
      first.value = state.customer.first_name;
      last.value = state.customer.last_name;
      email.value = state.customer.email;
      phone.value = state.customer.phone || '';
      const privacy = h('input', { type: 'checkbox', required: true });
      const waBox = h('input', { type: 'checkbox' });
      const mkBox = h('input', { type: 'checkbox' });
      const err = h('p', { class: 'err', role: 'alert' });
      const send = h('button', { type: 'submit', class: 'btn btn-primary' }, 'Mandami il codice');
      const privacyLink = h('a', { href: '/privacy/#prenotazione-online', target: '_blank' }, 'informativa privacy');

      const form = h('form', { novalidate: true },
        h('div', { class: 'recap' }, h('strong', {}, whenLabel(`${state.date} ${state.time}:00`)), h('span', { class: 'muted small' }, chosen().map((s) => s.name).join(' + '))),
        h('div', { class: 'two' }, field('Nome', first), field('Cognome', last)),
        field('Email (ti mandiamo il codice e la conferma)', email),
        field('Cellulare (facoltativo)', phone),
        field('Note per Jenny (facoltativo)', note),
        h('fieldset', {}, h('legend', {}, 'Privacy'),
          h('label', { class: 'check' }, privacy, h('span', {}, 'Ho letto l’', privacyLink, ' (obbligatorio per prenotare).')),
          cat.rules.whatsapp_available && h('label', { class: 'check' }, waBox, h('span', {}, 'Voglio ricevere conferma e promemoria anche su WhatsApp (facoltativo).')),
          h('label', { class: 'check' }, mkBox, h('span', {}, 'Voglio ricevere novità e offerte del salone (facoltativo).')),
          h('p', { class: 'muted small' }, 'I consensi facoltativi sono separati: puoi prenotare anche senza.')),
        err,
        h('div', { class: 'actions' }, send, (() => { const b = h('button', { type: 'button', class: 'linkbtn' }, '← Cambia orario'); b.addEventListener('click', stepSlot); return b; })()),
      );
      form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        err.textContent = '';
        if (!first.value.trim() || !last.value.trim()) return void (err.textContent = 'Scrivi nome e cognome.');
        if (!email.checkValidity() || !email.value) return void (err.textContent = 'Controlla l’email.');
        if (!privacy.checked) return void (err.textContent = 'Per prenotare serve la presa visione dell’informativa privacy.');
        send.disabled = true;
        try {
          const out = await api<{ token: string; expires_in_min: number }>(API, '/bookings', {
            service_ids: [...state.selected], date: state.date, time: state.time, note: note.value,
            customer: { first_name: first.value, last_name: last.value, email: email.value, phone: phone.value },
            consents: { privacy_notice: true, whatsapp: waBox.checked, marketing: mkBox.checked, privacy_version: app.dataset.privacy },
          });
          state.customer = { first_name: first.value.trim(), last_name: last.value.trim(), email: email.value.trim().toLowerCase(), phone: phone.value.trim() || null };
          state.token = out.token;
          state.expires = Date.now() + out.expires_in_min * 60_000;
          stepCode(email.value);
        } catch (e) {
          send.disabled = false;
          if (e instanceof ApiError && e.code === 'slot_taken') {
            alert('Qualcuno ha appena preso questo orario. Scegline un altro.');
            return stepSlot();
          }
          err.textContent = (e as Error).message;
        }
      });
      show(3, h('div', { class: 'card panel' }, h('h2', {}, 'I tuoi dati'), form));
      first.focus();
    }

    // 4 · Review customer details and verify the email on the same hold.
    function stepCode(_address: string) {
      const code = h('input', { class: 'code', type: 'text', inputmode: 'numeric', autocomplete: 'one-time-code', maxlength: 6, pattern: '[0-9]{6}', 'aria-label': 'Codice di 6 cifre' });
      const err = h('p', { class: 'err', role: 'alert' });
      const feedback = h('p', { class: 'small', role: 'status' });
      const timer = h('p', { class: 'muted small' });
      const summary = h('dl', { class: 'customer-summary' });
      const address = h('strong', { class: 'otp-address' }, state.customer.email);
      const ok = h('button', { type: 'submit', class: 'btn btn-primary' }, cat.rules.auto_confirm ? 'Conferma appuntamento' : 'Verifica e invia richiesta');
      const correct = h('button', { type: 'button', class: 'linkbtn' }, 'Modifica dati');
      const resend = h('button', { type: 'button', class: 'btn btn-ghost' }, 'Rinvia codice');
      const first = h('input', { type: 'text', required: true, maxlength: 80, autocomplete: 'given-name' });
      const last = h('input', { type: 'text', required: true, maxlength: 80, autocomplete: 'family-name' });
      const email = h('input', { type: 'email', required: true, maxlength: 190, autocomplete: 'email', inputmode: 'email' });
      const phone = h('input', { type: 'tel', maxlength: 20, autocomplete: 'tel', inputmode: 'tel' });
      const save = h('button', { type: 'submit', class: 'btn btn-primary' }, 'Salva dati');
      const cancel = h('button', { type: 'button', class: 'linkbtn' }, 'Annulla');
      const field = (label: string, input: HTMLInputElement) => h('label', { class: 'f' }, label, input);
      const editForm = h('form', { hidden: true }, field('Nome', first), field('Cognome', last), field('Cellulare (facoltativo)', phone), field('Email', email), h('div', { class: 'actions' }, save, cancel));
      const pasteOtp = h('button', { type:'button', class:'btn btn-ghost' }, '📋 Incolla codice');
      pasteOtp.addEventListener('click', async () => {
        try { code.value = (await navigator.clipboard.readText()).replace(/[^0-9]/g,'').slice(0,6); code.focus(); }
        catch { feedback.textContent = 'Per incollare il codice, usa il menu Incolla del telefono o del browser.'; }
      });
      const verifyForm = h('form', {}, h('label', { class: 'f' }, 'Codice di 6 cifre', code), h('div', { class:'actions' }, ok, pasteOtp));
      const again = h('button', { type: 'button', class: 'btn btn-ghost', hidden: true }, 'Scegli un nuovo orario');
      let retryAt = Date.now() + 60_000;
      let busy = false;
      let terminal = false;
      const emailChanged = () => email.value.trim().toLowerCase() !== state.customer.email;
      const refresh = () => {
        const expired = Date.now() >= state.expires;
        const wait = Math.max(0, Math.ceil((retryAt - Date.now()) / 1000));
        const editing = !editForm.hidden;
        ok.disabled = busy || terminal || expired || editing;
        resend.disabled = busy || terminal || expired || editing || wait > 0;
        resend.textContent = wait ? `Rinvia codice tra ${wait}s` : 'Rinvia codice';
        save.disabled = busy || terminal || expired || (emailChanged() && wait > 0);
        save.textContent = emailChanged() ? (wait ? `Invia nuovo codice tra ${wait}s` : 'Salva e invia nuovo codice') : 'Salva dati';
        correct.disabled = busy || terminal || expired;
        cancel.disabled = busy;
        for (const input of [first, last, email, phone]) input.disabled = busy;
        again.hidden = !(expired || terminal);
        const left = Math.max(0, Math.ceil((state.expires - Date.now()) / 1000));
        timer.textContent = left ? `Orario riservato ancora per ${Math.floor(left / 60)}:${String(left % 60).padStart(2, '0')}.` : 'Tempo scaduto. Scegli di nuovo un orario; i tuoi dati restano disponibili in questa sessione.';
      };
      const renderSummary = () => {
        summary.replaceChildren(...[
          ['Nome e cognome', state.customer.first_name + ' ' + state.customer.last_name],
          ['Cellulare', state.customer.phone || 'Non indicato'],
          ['Email', state.customer.email],
        ].flatMap(([label, value]) => [h('dt', {}, label), h('dd', {}, value)]));
        address.textContent = state.customer.email;
      };
      correct.addEventListener('click', () => {
        first.value = state.customer.first_name; last.value = state.customer.last_name;
        phone.value = state.customer.phone || ''; email.value = state.customer.email;
        editForm.hidden = false; verifyForm.hidden = true; refresh(); first.focus();
      });
      cancel.addEventListener('click', () => { editForm.hidden = true; verifyForm.hidden = false; refresh(); correct.focus(); });
      email.addEventListener('input', refresh);
      const handleError = (e: unknown) => {
        err.textContent = (e as Error).message;
        if (e instanceof ApiError && ['hold_expired', 'too_many_attempts', 'not_found'].includes(e.code)) terminal = true;
      };
      editForm.addEventListener('submit', async ev => {
        ev.preventDefault();
        if (busy || terminal || Date.now() >= state.expires || (emailChanged() && Date.now() < retryAt)) return;
        if (!first.value.trim() || !last.value.trim()) { err.textContent = 'Scrivi nome e cognome.'; return; }
        const customer: Customer = { first_name: first.value.trim(), last_name: last.value.trim(), phone: phone.value.trim() || null, email: email.value.trim().toLowerCase() };
        const changingEmail = emailChanged();
        busy = true; err.textContent = ''; feedback.textContent = ''; refresh();
        try {
          const out = await api<{ customer: Customer; code_sent: boolean }>(API, '/bookings/update-customer', { token: state.token, customer });
          state.customer = out.customer; renderSummary();
          editForm.hidden = true; verifyForm.hidden = false;
          if (out.code_sent) { code.value = ''; retryAt = Date.now() + 60_000; }
          feedback.textContent = out.code_sent ? 'Dati aggiornati e nuovo codice inviato. Usa solo l’ultimo codice ricevuto.' : 'Dati aggiornati. Il codice già ricevuto resta valido.';
          code.focus();
        } catch (e) {
          if (e instanceof ApiError && e.code === 'email_failed') {
            state.customer = customer; renderSummary(); code.value = ''; retryAt = Date.now() + 60_000;
            editForm.hidden = true; verifyForm.hidden = false;
          } else if (changingEmail && e instanceof ApiError && e.status === 429) retryAt = Date.now() + 60_000;
          handleError(e);
        } finally { busy = false; refresh(); }
      });
      resend.addEventListener('click', async () => {
        if (resend.disabled) return;
        busy = true; err.textContent = ''; feedback.textContent = ''; refresh();
        try {
          await api(API, '/bookings/resend-otp', { token: state.token });
          code.value = ''; retryAt = Date.now() + 60_000;
          feedback.textContent = 'Nuovo codice inviato. Usa solo l’ultimo codice ricevuto.';
          code.focus();
        } catch (e) {
          if (e instanceof ApiError && (e.code === 'email_failed' || e.status === 429)) { retryAt = Date.now() + 60_000; code.value = ''; }
          handleError(e);
        } finally { busy = false; refresh(); }
      });
      const tick = setInterval(refresh, 1000);
      again.addEventListener('click', () => { clearInterval(tick); stepSlot(); });
      verifyForm.addEventListener('submit', async ev => {
        ev.preventDefault();
        if (ok.disabled) return;
        if (!/^\d{6}$/.test(code.value.trim())) { err.textContent = 'Il codice ha 6 cifre.'; return; }
        busy = true; err.textContent = ''; refresh();
        try {
          const booking = await api<PublicBooking>(API, '/bookings/verify', { token: state.token, code: code.value.trim() });
          clearInterval(tick); stepDone(booking);
        } catch (e) { handleError(e); }
        finally { busy = false; refresh(); }
      });
      renderSummary(); refresh();
      show(4, h('div', { class: 'card panel otp-panel' }, h('h2', {}, 'Controlla i tuoi dati'),
        h('div', { class: 'recap' }, h('strong', {}, whenLabel(`${state.date} ${state.time}:00`)), h('span', { class: 'small' }, chosen().map(s => s.name).join(' + '))),
        summary, correct, editForm,
        h('p', {}, 'Codice inviato a ', address, '. Se non lo trovi controlla anche lo spam.'),
        verifyForm, feedback, err, resend, timer, again));
      code.focus();
    }

    // Fatto
    function stepDone(b: PublicBooking) {
      const url = `${location.origin}/gestisci/#${state.token}`;
      const pending = b.status === 'pending';
      const copy = h('button', { type: 'button', class: 'btn btn-ghost' }, 'Copia il link');
      copy.addEventListener('click', () => navigator.clipboard?.writeText(url).then(() => (copy.textContent = 'Copiato')));
      app.querySelectorAll('.steps li').forEach((li) => li.classList.add('done'));
      view.replaceChildren(h('div', { class: 'card panel' },
        h('p', { class: 'ok' }, pending ? 'Richiesta inviata' : 'Appuntamento confermato'),
        h('h2', {}, whenLabel(b.starts_at)),
        h('div', { class: 'recap' }, h('ul', {}, ...b.items.map((i) => h('li', {}, i.name))), cat.rules.public_show_price && h('span', { class: 'small' }, `Totale di listino: ${euro(b.total_cents)}`)),
        h('p', {}, pending
          ? 'Jenny conferma a breve: ti arriva un’email quando l’appuntamento è confermato.'
          : 'Ti abbiamo mandato un’email di conferma. Ti ricordiamo l’appuntamento il giorno prima e un’ora prima.'),
        h('p', { class: 'small' }, `Per spostare o annullare usa il tuo link personale (fino a ${cat.rules.customer_change_limit_h} ore prima). È anche nell’email: non condividerlo.`),
        h('p', { class: 'manage-url' }, url),
        h('div', { class: 'actions' }, h('a', { class: 'btn btn-primary', href: `/gestisci/#${state.token}` }, 'Apri il mio appuntamento'), copy)));
      app.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
</script>

