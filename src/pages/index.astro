---
import { Image } from 'astro:assets';
import { BOOKING_ONLINE } from '../data/booking';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Hours from '../components/Hours.astro';
import { SITE, BOOK_HREF, WHATSAPP, waLink, WA_HELLO, fullAddress, directionsHref } from '../data/site';
import { TRATTAMENTI } from '../data/trattamenti';
import { FAQS } from '../data/faq';
import { GALLERIA } from '../data/galleria';

const hero = GALLERIA[0];
const wa = waLink(WA_HELLO);
const addr = fullAddress();
const dir = directionsHref();
const bookExt = BOOK_HREF.startsWith('http');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const steps = BOOKING_ONLINE ? [
  { icon: 'sparkles', title: 'Scegli trattamento e orario', text: 'Seleziona i servizi, poi il giorno e una fascia disponibile.' },
  { icon: 'shield-check', title: 'Inserisci i dati e verifica l’email', text: 'Compila i recapiti e inserisci il codice ricevuto via email.' },
  { icon: 'calendar-heart', title: 'Controlla la conferma', text: 'L’appuntamento è valido quando la richiesta risulta confermata.' },
] as const : [
  { icon: 'sparkles', title: 'Scegli il trattamento', text: 'Indica il servizio che desideri. Se hai dubbi, chiedici un consiglio.' },
  { icon: 'message-circle', title: WHATSAPP ? 'Scrivici su WhatsApp' : 'Contattaci', text: 'Comunicaci il giorno e l’orario che preferisci.' },
  { icon: 'calendar-heart', title: 'Attendi la conferma', text: 'L’appuntamento è valido dopo la conferma del salone.' },
] as const;
---
<Base title="Jenny Nails Studio · Manicure, semipermanente e nail art" schema={[faqSchema]}>
  <section class="hero">
    <div class="wrap hero-in">
      <div class="hero-txt">
        <p class="eyebrow">Salone di manicure{SITE.address && ` · ${SITE.address.city}`}</p>
        <h1>Le tue unghie, <em>curate</em> con calma.</h1>
        <p class="lead muted">Manicure, semipermanente, ricostruzione e nail art{SITE.byAppointment && ', su appuntamento'}. Scegli il trattamento e prenota il tuo appuntamento.</p>
        <div class="ctas">
          <a class="btn btn-primary" href={BOOK_HREF} rel={bookExt ? 'noopener' : undefined}>
            <Icon name={BOOKING_ONLINE ? 'calendar-heart' : (WHATSAPP ? 'message-circle' : 'calendar-heart')} />{BOOKING_ONLINE ? 'Prenota online' : (WHATSAPP ? 'Prenota su WhatsApp' : 'Prenota un appuntamento')}
          </a>
          <a class="btn btn-ghost" href="/trattamenti/">Vedi i trattamenti</a>
        </div>
        {SITE.phone && (
          <p class="call muted">Preferisci chiamare? <a href={`tel:${SITE.phone.tel}`}>{SITE.phone.display}</a></p>
        )}
      </div>
      <div class="hero-art" id="jenny-dynamic-hero">
        {hero ? (
          <Image src={hero.src} alt={hero.alt} widths={[480, 720, 960]} sizes="(max-width: 899px) 100vw, 480px" loading="eager" class="hero-img" />
        ) : (
          <div class="swatches" aria-hidden="true">
            <span style="--c:#f2c9d3;--r:-14deg;--y:22px" />
            <span style="--c:#8e4a5e;--r:-6deg;--y:4px" />
            <span style="--c:#e9cfc0;--r:2deg;--y:0px" />
            <span style="--c:#c98f9d;--r:9deg;--y:10px" />
            <span style="--c:#b08a4f;--r:17deg;--y:34px" />
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section section-alt" id="trattamenti">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Trattamenti</p>
        <h2 class="title-lg">Cosa possiamo fare per le tue mani</h2>
      </div>
      <ul class="tgrid">
        {TRATTAMENTI.map((t) => (
          <li>
            <a class="card tcard" href={`/trattamenti/#${t.slug}`}>
              <span class="ticon"><Icon name={t.icon} /></span>
              <span class="tname">{t.name}</span>
              <span class="muted tshort">{t.short}</span>
              {t.price && <span class="tprice">{t.price}</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section booking-guide" id="come-prenotare" aria-labelledby="booking-guide-title">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Come si prenota</p>
        <h2 id="booking-guide-title">Prenota in tre passaggi</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="num" aria-hidden="true">{i + 1}</span>
            <div class="step-copy"><h3>{s.title}</h3><p class="muted">{s.text}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {GALLERIA.length > 1 && (
    <section class="section section-alt" id="lavori">
      <div class="wrap">
        <div class="head">
          <p class="eyebrow">I nostri lavori</p>
          <h2 class="title-lg">Qualche idea da cui partire</h2>
        </div>
        <ul class="gal" aria-label="Galleria dei lavori">
          {GALLERIA.map((g) => (
            <li><Image src={g.src} alt={g.alt} widths={[320, 480, 720]} sizes="(max-width: 760px) 70vw, 280px" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section" id="studio">
    <div class="wrap studio">
      <div class="studio-txt">
        <p class="eyebrow">Lo studio</p>
        <h2 class="title-lg">Un appuntamento <em>tutto per te</em></h2>
        <p class="muted">Ogni appuntamento ha il suo tempo: per scegliere forma e colore, sistemare le cuticole e arrivare a un risultato curato. Parliamo prima di cosa vuoi, poi lavoriamo.</p>
        <ul class="pts">
          <li><Icon name="heart" size={20} />Consigli sinceri su cosa sta bene alle tue unghie</li>
          <li><Icon name="shield-check" size={20} />Strumenti puliti e postazione preparata per ogni cliente</li>
          <li><Icon name="palette" size={20} />Colori e decorazioni scelti insieme</li>
        </ul>
      </div>
      <div class="card info">
          {addr && (
            <div>
              <h3><Icon name="map-pin" size={20} />Dove siamo</h3>
              <p>{addr}</p>
              {dir && <a class="btn btn-ghost sm" href={dir} rel="noopener"><Icon name="navigation" size={18} />Indicazioni</a>}
            </div>
          )}
          <div>
            <h3><Icon name="clock" size={20} />Orari</h3>
            <Hours />
          </div>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="faq">
    <div class="wrap faqw">
      <div class="head">
        <p class="eyebrow">Domande frequenti</p>
        <h2 class="title-lg">Prima di prenotare</h2>
      </div>
      <div class="faq">
        {FAQS.map((f) => (
          <details>
            <summary>{f.q}<Icon name="chevron-right" size={20} class="chev" /></summary>
            <p class="muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="card final">
        <h2 class="title-lg">Voglia di unghie <em>nuove</em>?</h2>
        <p class="muted">{BOOKING_ONLINE ? 'Scegli trattamento, giorno e orario dal modulo online.' : 'Scrivici il trattamento e il giorno che preferisci.'}</p>
        <div class="ctas">
          {BOOKING_ONLINE && <a class="btn btn-primary" href={BOOK_HREF}><Icon name="calendar-heart" />Prenota online</a>}
          {wa && <a class={BOOKING_ONLINE ? 'btn btn-ghost' : 'btn btn-primary'} href={wa} rel="noopener"><Icon name="message-circle" />Scrivi su WhatsApp</a>}
          {SITE.phone && <a class={wa ? 'btn btn-ghost' : 'btn btn-primary'} href={`tel:${SITE.phone.tel}`}><Icon name="phone" />Chiama {SITE.phone.display}</a>}
          {!wa && !SITE.phone && <a class="btn btn-primary" href="/contatti/">Contatti</a>}
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: 72px 88px; background: radial-gradient(1200px 520px at 85% 10%, var(--cipria) 0%, transparent 60%); overflow: hidden; }
  .hero-in { display: grid; grid-template-columns: 1.1fr .9fr; gap: 48px; align-items: center; }
  .hero-txt { display: flex; flex-direction: column; gap: 20px; }
  h1 { font-size: clamp(42px, 7vw, 76px); }
  .lead { font-size: 19px; max-width: 34ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .call { font-size: 15px; }
  .hero-art { overflow:hidden; border-radius:24px; min-width:0; max-width:480px; width:100%; margin-inline:auto; box-shadow:var(--ombra); }
  .hero-img { display:block; width:100%; height:auto; aspect-ratio: 4 / 5; object-fit:cover; object-position:center 38%; border-radius:inherit; }

  /* Cinque "unghie" di colore: decorazione finché non ci sono foto vere. */
  .swatches { position: relative; aspect-ratio: 1; max-width: 440px; margin-inline: auto; display: flex; align-items: center; justify-content: center; gap: 4%; }
  .swatches::before { content: ''; position: absolute; inset: 6%; border-radius: 50%; background: var(--cipria); border: 1px solid var(--bordo); }
  .swatches span {
    position: relative; width: 14%; aspect-ratio: 1 / 1.75; background: var(--c);
    border-radius: 50% 50% 42% 42% / 62% 62% 38% 38%;
    transform: translateY(var(--y)) rotate(var(--r));
    box-shadow: inset -6px -8px 14px rgba(0, 0, 0, .08), inset 6px 8px 12px rgba(255, 255, 255, .45), 0 10px 20px rgba(45, 34, 38, .12);
  }

  .tgrid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .tcard { display: flex; flex-direction: column; gap: 8px; padding: 24px; height: 100%; text-decoration: none; color: inherit; transition: border-color .15s, transform .15s; }
  .tcard:hover { border-color: var(--malva); color: inherit; transform: translateY(-2px); }
  .ticon { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--cipria); color: var(--malva); margin-bottom: 6px; }
  .tname { font-family: var(--serif); font-size: 23px; }
  .tshort { font-size: 15.5px; }
  .tprice { font-weight: 700; color: var(--malva); }

  .booking-guide { padding-block:32px; }
  .booking-guide .head { margin-bottom:18px; }
  .booking-guide h2 { font-family:var(--sans);font-size:clamp(21px,3vw,27px);font-weight:650;letter-spacing:-.02em;line-height:1.3; }
  .steps { list-style:none;margin:0;padding:0;display:grid;grid-template-columns:minmax(0,1fr);gap:0; }
  .steps li { display:grid;grid-template-columns:28px minmax(0,1fr);gap:12px;align-items:start;padding:14px 0;border-top:1px solid var(--bordo);min-width:0; }
  .num { display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--cipria);color:var(--malva);font-family:var(--sans);font-size:13px;font-weight:700;line-height:1; }
  .steps h3 { margin:0 0 4px;font-family:var(--sans);font-size:16px;font-weight:650;line-height:1.4;letter-spacing:0; }
  .steps p { margin:0;font-size:14px;line-height:1.55;overflow-wrap:anywhere; }
  @media(min-width:900px) { .steps { grid-template-columns:repeat(3,minmax(0,1fr));gap:24px; } .booking-guide { padding-block:40px; } }

  .gal { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
  .gal img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 16px; }

  .studio { display: grid; grid-template-columns: 1.2fr .8fr; gap: 48px; align-items: start; }
  .studio-txt { display: flex; flex-direction: column; gap: 16px; }
  .pts { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .pts li { display: flex; gap: 12px; align-items: flex-start; }
  .pts :global(.icon) { color: var(--malva); flex: none; margin-top: 3px; }
  .info { padding: 28px; display: flex; flex-direction: column; gap: 24px; }
  .info > div { display: flex; flex-direction: column; gap: 10px; }
  .info > div + div { border-top: 1px solid var(--bordo); padding-top: 24px; }
  .info h3 { font-family: var(--sans); font-weight: 700; font-size: 17px; display: flex; gap: 8px; align-items: center; letter-spacing: 0; }
  .info h3 :global(.icon) { color: var(--malva); }
  .sm { min-height: 44px; padding: 0 18px; font-size: 15px; align-self: flex-start; }

  .faqw { max-width: 820px; }
  .faq { display: flex; flex-direction: column; gap: 10px; }
  .faq details { background: var(--bianco); border: 1px solid var(--bordo); border-radius: 16px; }
  .faq summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 22px; font-weight: 700; min-height: 56px; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary :global(.chev) { color: var(--malva); flex: none; transition: transform .2s; }
  .faq details[open] summary :global(.chev) { transform: rotate(90deg); }
  .faq details p { padding: 0 22px 20px; }

  .final { padding: 48px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14px; background: linear-gradient(160deg, var(--bianco), var(--cipria)); }
  .final .ctas { justify-content: center; margin-top: 8px; }

  @media (max-width: 899px) {
    .hero { padding-block: 16px 56px; }
    .hero-in { grid-template-columns: 1fr; gap: 12px; }
    .hero-art { order: -1; }
    .swatches { max-width: 210px; }
    .hero-art { max-width:420px; border-radius:22px; }
    .hero-img { aspect-ratio: 4 / 3; }
    .studio { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 760px) {
    /* Foto d'impatto ma compatta: titolo e prenotazione restano visibili senza scorrere troppo. */
    .hero { padding-block:14px 36px; }
    .hero-in { gap:18px; }
    .hero-art { width:min(100%, 340px); max-width:100%; border-radius:18px; }
    .hero-img { aspect-ratio: 16 / 10; object-position:center 39%; }
    .hero-txt { gap:14px; }
    h1 { font-size:clamp(34px, 9vw, 48px); }

    .lead { font-size: 17px; }
    .ctas .btn { flex: 1 1 100%; }
    .tgrid { grid-template-columns: 1fr; }
    .gal { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 10px; margin-inline: -16px; padding-inline: 16px; }
    .gal li { flex: 0 0 70%; scroll-snap-align: start; }
    .final { padding: 32px 20px; }
  }
</style>

<script>
  import { BOOKING_API } from '../data/booking';
  const host = document.getElementById('jenny-dynamic-hero');
  const apiOrigin = new URL(BOOKING_API).origin;
  const mediaPrefix = '/api/jenny/public/media/';
  fetch(BOOKING_API + '/catalog').then(r => r.ok ? r.json() : null).then(data => {
    const path: unknown = data?.branding?.hero_url;
    if (!host || typeof path !== 'string' || !path.startsWith(mediaPrefix)) return;
    const filename = path.slice(mediaPrefix.length);
    if (!/^[a-f0-9]{24}[.](jpg|png|webp)$/.test(filename)) return;
    const img = document.createElement('img');
    img.alt = typeof data.branding.hero_alt === 'string' ? data.branding.hero_alt : 'Jenny Nails Studio';
    const clamp = (n: unknown, min: number, max: number, fallback: number) =>
      typeof n === 'number' && Number.isFinite(n) ? Math.min(max, Math.max(min, n)) : fallback;
    const x = clamp(data.branding.hero_x, 0, 100, 50);
    const y = clamp(data.branding.hero_y, 0, 100, 50);
    const zoom = clamp(data.branding.hero_zoom, 100, 200, 100);
    img.className = 'hero-img';
    img.width = 480;
    img.height = 600;
    img.style.objectPosition = x + '% ' + y + '%';
    // Lo zoom resta confinato alla cornice: non spinge né copre il testo su mobile.
    if (zoom > 100) { img.style.transform = 'scale(' + (zoom / 100) + ')'; img.style.transformOrigin = x + '% ' + y + '%'; }
    img.decoding = 'async';
    img.onload = () => { host.replaceChildren(img); };
    img.src = apiOrigin + path;
  }).catch(() => { /* mantieni la hero predefinita */ });
</script>
