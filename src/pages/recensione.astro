---
import Base from '../layouts/Base.astro';
import '../styles/booking.css';
import { BOOKING_API } from '../data/booking';
---
<Base title="La tua esperienza · Jenny Nails Studio" description="Racconta la tua esperienza da Jenny Nails Studio." noindex>
  <section class="bk" id="review" data-api={BOOKING_API}>
    <p class="eyebrow">Jenny Nails Studio</p>
    <h1 class="title-lg">La tua <em>esperienza</em></h1>
    <div class="card panel" id="review-view" aria-live="polite"><p>Caricamento…</p></div>
  </section>
</Base>
<script>
  import { api, h } from '../scripts/booking-client';
  const root = document.getElementById('review')!;
  const view = document.getElementById('review-view')!;
  const token = location.hash.slice(1);
  const base = root.dataset.api!;
  async function start() {
    if (!/^[a-f0-9]{64}$/.test(token)) { view.textContent = 'Link non disponibile. Contatta il salone per una nuova richiesta.'; return; }
    try {
      const state = await api<{ feedback_submitted: boolean }>(base, '/reviews/landing', { token });
      // Google is available to everyone, independently from rating or private feedback.
      const google = h('a', { class: 'btn btn-primary', href: base + '/reviews/r/' + token, target: '_blank', rel: 'noopener noreferrer' }, 'Scrivi una recensione su Google');
      const intro = h('p', {}, 'Vuoi raccontare la tua esperienza? Puoi lasciare una recensione pubblica su Google oppure un feedback privato al salone. Entrambi sono facoltativi.');
      const privateBox = h('div', { class: 'review-private' });
      view.replaceChildren(intro, google, h('p', { class: 'small muted' }, 'La recensione Google si scrive sul sito di Google e non viene pubblicata da questa pagina.'), privateBox);
      if (state.feedback_submitted) { privateBox.textContent = 'Grazie, il tuo feedback privato è già stato registrato.'; return; }
      const votes = h('fieldset', { class: 'review-votes' }, h('legend', {}, 'Come è stata la tua esperienza?'));
      for (let rating = 1; rating <= 5; rating++) votes.append(h('label', {}, h('input', { type: 'radio', name: 'rating', value: rating, required: true }), String(rating) + ' ★'));
      const text = h('textarea', { maxlength: 2000, rows: 4, placeholder: 'Cosa ti è piaciuto? Cosa possiamo migliorare?' });
      const status = h('p', { role: 'status' });
      const submit = h('button', { class: 'btn btn-ghost', type: 'submit' }, 'Invia feedback privato');
      const form = h('form', {}, h('h2', {}, 'Un messaggio solo per noi'), votes,
        h('label', { class: 'f' }, 'Commento (facoltativo)', text),
        h('p', { class: 'small muted' }, 'Voto e commento saranno visibili solo allo staff. Non inserire dati sensibili.'),
        submit, status);
      form.addEventListener('submit', async event => {
        event.preventDefault();
        const vote = form.querySelector<HTMLInputElement>('input[name="rating"]:checked');
        if (!vote || submit.disabled) return;
        submit.disabled = true;
        try {
          await api(base, '/reviews/feedback', { token, rating: Number(vote.value), text: text.value });
          privateBox.replaceChildren(h('p', { role: 'status' }, 'Grazie! Il tuo feedback privato è stato registrato.'));
        } catch (error) { status.textContent = (error as Error).message; submit.disabled = false; }
      });
      privateBox.append(form);
    } catch (error) { view.textContent = (error as Error).message; }
  }
  void start();
</script>
<style>
  :global(#review .review-private) { border-top:1px solid var(--bordo);padding-top:24px; }
  :global(#review .review-votes) { flex-direction:row;flex-wrap:wrap;gap:12px; }
  :global(#review .review-votes label) { min-height:48px;display:flex;align-items:center;gap:6px; }
  :global(#review .review-votes input) { width:20px;height:20px;accent-color:var(--malva); }
  :global(#review-view .btn) { min-height:48px;white-space:normal;text-align:center;overflow-wrap:anywhere; }
  :global(#review-view textarea) { min-width:0;max-width:100%;box-sizing:border-box;font-size:max(1rem,16px); }
  :global(#review-view [role="status"]) { overflow-wrap:anywhere; }
</style>

