---
/** Logo tipografico, finché non c'è un logo vero (mettilo in public/logo.svg e sostituisci qui). */
interface Props { size?: 'sm' | 'lg' }
const { size = 'sm' } = Astro.props;
---
<span class:list={['wm', size]}>
  <span class="j">Jenny</span>
  <span class="s">Nails Studio</span>
</span>

<style>
  /* Unica proporzione del marchio, scalata in modo uniforme via font-size. */
  .wm { display:inline-flex; flex-direction:column; justify-content:center; align-items:flex-start; width:max-content; max-width:100%; line-height:1; color:var(--inchiostro); flex:0 0 auto; font-size:27px; }
  .wm .j, .wm .s { display:block; white-space:nowrap; }
  .j { font-family:Georgia,'Times New Roman',serif; font-style:italic; font-weight:500; font-size:1em; letter-spacing:-.02em; }
  .s { font-family:Arial,Helvetica,sans-serif; font-size:.31em; font-weight:700; letter-spacing:.17em; text-transform:uppercase; color:var(--malva); margin-top:.29em; padding-left:.2em; }
  .lg { font-size:29px; }
  @media(max-width:899px) { .wm { font-size:24px; } .lg { font-size:27px; } }
</style>
