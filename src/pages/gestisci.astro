---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import '../styles/booking.css';
import { SITE, waLink } from '../data/site';
import { BOOKING_API } from '../data/booking';

const wa = waLink('Ciao Jenny! Ti scrivo per il mio appuntamento.');
---
<Base title="Il mio appuntamento · Jenny Nails Studio" description="Controlla, sposta o annulla il tuo appuntamento da Jenny Nails Studio." noindex>
  <section class="bk">
    <p class="eyebrow">Il mio appuntamento</p>
    <h1 class="title-lg">Il tuo <em>appuntamento</em></h1>
    <div id="manage" data-api={BOOKING_API} aria-live="polite"><p class="muted">Carico l’appuntamento…</p></div>
    <noscript><p class="err">Per vedere l’appuntamento serve JavaScript.</p></noscript>
    <div id="email-update" class="card panel" style="margin-top:16px">
      <h2>💌 Resta in contatto con Jenny</h2>
      <p class="muted">Aggiungi o aggiorna la tua email per conferme e comunicazioni sui tuoi appuntamenti.</p>
      <form id="email-change-form">
        <label class="f">Indirizzo email
          <input id="email-change-address" type="email" autocomplete="email" required maxlength="190" placeholder="nome@esempio.it" />
        </label>
        <label class="f" style="display:flex;align-items:flex-start;gap:8px">
          <input id="email-change-privacy" type="checkbox" required />
          <span>Ho letto l’<a href="/privacy/" target="_blank" rel="noopener">informativa privacy</a> sul trattamento dei dati per aggiornare i miei recapiti.</span>
        </label>
        <label class="f" style="display:flex;align-items:flex-start;gap:8px">
          <input id="email-change-marketing" type="checkbox" />
          <span>✨ Voglio ricevere novità, nuove nail art, promozioni e offerte riservate via email. Consenso facoltativo, revocabile in seguito.</span>
        </label>
        <button id="email-change-send" type="submit" class="btn btn-primary">Invia codice di verifica</button>
      </form>
      <form id="email-change-verify" hidden>
        <label class="f">Codice ricevuto via email
          <input id="email-change-code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" required />
        </label>
        <div class="actions">
          <button class="btn btn-primary" type="submit">Verifica e salva email</button>
          <button class="btn btn-ghost" id="email-change-paste" type="button">📋 Incolla codice</button>
        </div>
      </form>
      <p id="email-change-feedback" class="muted" role="status" aria-live="polite"></p>
    </div>


    <div id="help" class="card panel" hidden>
      <h2>Serve aiuto?</h2>
      <p class="muted">Scrivici o chiamaci e sistemiamo noi l’appuntamento.</p>
      <div class="actions">
        {wa && <a class="btn btn-wa" href={wa} rel="noopener"><Icon name="message-circle" />WhatsApp</a>}
        {SITE.phone && <a class="btn btn-ghost" href={`tel:${SITE.phone.tel}`}><Icon name="phone" />{SITE.phone.display}</a>}
      </div>
    </div>
  </section>
</Base>

<script>
  import { api, h, slotPicker, whenLabel, euro, type Slot } from '../scripts/booking-client';

  interface PublicBooking {
    status: string; starts_at: string; ends_at: string; public_show_price?: boolean; total_cents: number | null; total_max_cents?: number | null;
    items: { name: string; price_cents: number | null; price_max_cents?: number | null; duration_min: number }[];
    can_change: boolean; change_deadline: string;
    salon: { name: string; address: string | null; phone: string | null };
  }
  const STATUS: Record<string, string> = {
    pending: 'In attesa di conferma', confirmed: 'Confermato', cancelled: 'Annullato',
    completed: 'Completato', no_show: 'Non presentata',
  };

  const box = document.getElementById('manage')!;
  const help = document.getElementById('help')!;
  const API = box.dataset.api!;
  // Il token sta nel frammento (#…): il browser non lo manda al server del sito.
  const token = decodeURIComponent(location.hash.slice(1)).trim();
  addEventListener('hashchange', () => location.reload());


  const emailForm=document.getElementById('email-change-form') as HTMLFormElement;
  const emailVerify=document.getElementById('email-change-verify') as HTMLFormElement;
  const emailFeedback=document.getElementById('email-change-feedback')!;
  emailForm.addEventListener('submit',async event=>{
    event.preventDefault();if(!emailForm.reportValidity())return;
    const button=document.getElementById('email-change-send') as HTMLButtonElement;
    button.disabled=true;emailFeedback.textContent='Invio del codice in corso…';
    try{
      await api(API,'/manage/email/start',{token,email:(document.getElementById('email-change-address') as HTMLInputElement).value,privacy_accepted:(document.getElementById('email-change-privacy') as HTMLInputElement).checked,marketing:(document.getElementById('email-change-marketing') as HTMLInputElement).checked});
      emailFeedback.textContent='💌 Codice inviato. Controlla la posta e inseriscilo qui sotto.';
      emailVerify.hidden=false;
    }catch(e){emailFeedback.textContent=(e as Error).message;}finally{button.disabled=false;}
  });
  emailVerify.addEventListener('submit',async event=>{
    event.preventDefault();if(!emailVerify.reportValidity())return;
    const button=emailVerify.querySelector('button[type="submit"]') as HTMLButtonElement;
    button.disabled=true;
    try{
      await api(API,'/manage/email/verify',{token,code:(document.getElementById('email-change-code') as HTMLInputElement).value.trim()});
      emailFeedback.textContent='✅ Email verificata e salvata correttamente.';
      emailVerify.hidden=true;emailForm.hidden=true;
    }catch(e){emailFeedback.textContent=(e as Error).message;}finally{button.disabled=false;}
  });
  document.getElementById('email-change-paste')!.addEventListener('click',async()=>{
    try{(document.getElementById('email-change-code') as HTMLInputElement).value=(await navigator.clipboard.readText()).replace(/\D/g,'').slice(0,6);}
    catch{emailFeedback.textContent='Incolla il codice manualmente: il browser non consente di leggere gli appunti.';}
  });

  if (!/^[A-Za-z0-9_-]{20,100}$/.test(token)) {
    box.replaceChildren(h('div', { class: 'card panel' }, h('h2', {}, 'Link non valido'),
      h('p', { class: 'muted' }, 'Apri il link dall’email di conferma, senza modificarlo.')));
    help.hidden = false;
  } else {
    load();
  }

  async function load() {
    try {
      render(await api<PublicBooking>(API, '/manage', { token }));
    } catch (e) {
      box.replaceChildren(h('div', { class: 'card panel' }, h('h2', {}, 'Appuntamento non trovato'), h('p', { class: 'muted' }, (e as Error).message)));
      help.hidden = false;
    }
  }

  function render(b: PublicBooking, notice?: string) {
    help.hidden = false;
    const active = b.status === 'pending' || b.status === 'confirmed';
    const panel = h('div', { class: 'card panel' },
      notice && h('p', { class: 'ok', role: 'status' }, notice),
      h('p', {}, h('span', { class: `badge ${b.status}` }, STATUS[b.status] || b.status)),
      h('h2', {}, whenLabel(b.starts_at)),
      h('div', { class: 'recap' },
        h('ul', {}, ...b.items.map((i) => h('li', {}, i.name))),
        b.public_show_price === true && b.total_cents !== null && h('span', { class: 'small' }, `Totale di listino: ${euro(b.total_cents, b.total_max_cents)}`),
        b.salon.address && h('span', { class: 'small muted' }, `${b.salon.name}, ${b.salon.address}`)),
    );
    if (b.can_change) {
      const move = h('button', { type: 'button', class: 'btn btn-primary' }, 'Sposta');
      const cancel = h('button', { type: 'button', class: 'btn btn-ghost' }, 'Annulla l’appuntamento');
      move.addEventListener('click', () => reschedule(b));
      cancel.addEventListener('click', () => askCancel(b));
      panel.append(h('p', { class: 'muted small' }, `Puoi spostarlo o annullarlo fino a ${whenLabel(b.change_deadline)}.`), h('div', { class: 'actions' }, move, cancel));
    } else if (active) {
      panel.append(h('p', { class: 'muted small' }, 'Da qui non si può più modificare: per cambiamenti scrivici o chiamaci.'));
    }
    box.replaceChildren(panel);
    api<{ id: number; status: string; requested_start?: string; counteroffer_start?: string; counteroffer_slots?: string[]; expires_at?: string; expired?: boolean } | null>(
      API, '/manage/pending-change', { token }).then((req) => {
      if (!req || !['pending', 'counteroffered'].includes(req.status)) return;
      const note = h('div', { class: 'card panel' },
        h('h3', {}, req.status === 'pending' ? 'Richiesta in attesa di Jenny' : 'Nuova proposta di Jenny'),
        h('p', {}, req.status === 'pending'
          ? 'Il tuo appuntamento resta invariato fino alla risposta.'
          : 'Jenny propone: ' + whenLabel(req.counteroffer_start || '')));
      if (req.status === 'counteroffered') {
        const options = (req.counteroffer_slots?.length ? req.counteroffer_slots : (req.counteroffer_start ? [req.counteroffer_start] : []));
        const choice = h('div', { class: 'actions', role:'group', 'aria-label':'Seleziona un orario' });
        let selected = options.length === 1 ? options[0] : '';
        const yes = h('button', { class: 'btn btn-primary', type: 'button' }, 'Conferma orario selezionato') as HTMLButtonElement;
        const no = h('button', { class: 'btn btn-ghost', type: 'button' }, 'Rifiuta proposta') as HTMLButtonElement;
        for (const option of options) {
          const item = h('button', { type:'button', class:'btn btn-ghost', 'aria-pressed': String(selected === option) }, whenLabel(option)) as HTMLButtonElement;
          item.addEventListener('click', () => {
            selected = option;
            choice.querySelectorAll('button').forEach(el => { el.classList.remove('btn-primary'); el.classList.add('btn-ghost'); el.setAttribute('aria-pressed','false'); });
            item.classList.add('btn-primary'); item.classList.remove('btn-ghost'); item.setAttribute('aria-pressed','true');
            yes.disabled = false;
          });
          choice.append(item);
        }
        yes.disabled = !selected || !!req.expired;
        no.disabled = !!req.expired;
        if (req.expires_at) note.append(h('p', { class:'muted small' }, 'Proposta valida fino a: ' + whenLabel(req.expires_at)));
        if (req.expired) note.append(h('p', { class:'err' }, 'La proposta è scaduta: contatta Jenny per nuovi orari.'));
        const send = async (accept: boolean) => {
          if (accept && !selected) return;
          yes.disabled = true; no.disabled = true;
          try {
            await api(API, '/manage/respond-counteroffer', { token, request_id: req.id, accept, selected_start: accept ? selected : null });
            await load();
          } catch (err) {
            yes.disabled = !selected; no.disabled = false;
            note.append(h('p', { class: 'err', role: 'alert' }, (err as Error).message));
          }
        };
        yes.addEventListener('click', () => void send(true));
        no.addEventListener('click', () => void send(false));
        note.append(h('p',{class:'muted small'},'Scegli uno degli orari proposti. Il tuo appuntamento originale rimane invariato finché non confermi.'),choice,h('div',{class:'actions'},yes,no));
      }
      box.append(note);
    }).catch(() => { /* La prenotazione resta visualizzabile. */ });
  }

  function reschedule(b: PublicBooking) {
    const err = h('p', { class: 'err', role: 'alert' });
    const picker = slotPicker({
      days: 60,
      load: (date) => api<{ slots: Slot[] }>(API, '/manage/availability', { token, date }),
      onPick: async (date, time) => {
        if (!confirm(`Inviare a Jenny una richiesta per ${whenLabel(`${date} ${time}:00`)}? Il tuo appuntamento attuale resta valido fino all’approvazione.`)) return;
        err.textContent = '';
        try {
          await api(API, '/manage/request-reschedule', { token, date, time });
          render(b, 'Richiesta inviata a Jenny. L’appuntamento non cambia finché non sarà approvato.');
        } catch (e) {
          err.textContent = (e as Error).message;
        }
      },
    });
    const back = h('button', { type: 'button', class: 'linkbtn' }, '← Lascia com’è');
    back.addEventListener('click', () => render(b));
    box.replaceChildren(h('div', { class: 'card panel' }, h('h2', {}, 'Richiedi un nuovo orario'),
      h('p', { class: 'muted small' }, `Adesso: ${whenLabel(b.starts_at)}. L’appuntamento originale resta confermato fino alla risposta di Jenny.`), picker, err, back));
  }

  function askCancel(b: PublicBooking) {
    const reason = h('textarea', { rows: 2, maxlength: 300 });
    const err = h('p', { class: 'err', role: 'alert' });
    const yes = h('button', { type: 'submit', class: 'btn btn-primary' }, 'Sì, annulla');
    const no = h('button', { type: 'button', class: 'linkbtn' }, '← No, lo tengo');
    no.addEventListener('click', () => render(b));
    const form = h('form', {}, h('label', { class: 'f' }, 'Vuoi dirci il motivo? (facoltativo)', reason), err, h('div', { class: 'actions' }, yes, no));
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      yes.disabled = true;
      try {
        await api(API, '/manage/cancel', { token, reason: reason.value });
        await load();
      } catch (e) {
        yes.disabled = false;
        err.textContent = (e as Error).message;
      }
    });
    box.replaceChildren(h('div', { class: 'card panel' }, h('h2', {}, 'Annullare l’appuntamento?'), h('p', {}, whenLabel(b.starts_at)), form));
  }
</script>

